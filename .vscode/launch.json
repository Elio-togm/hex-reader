{
    "configurations": [
    {
        "name": "C++ Launch (Windows)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/main.exe",
        "args": ["--input-file=SLUS_205.91"],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
        "preLaunchTask": "C/C++: g++.exe build active file"
    },
    {
        "name": "C++ Launch (MacOS)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/${fileBasenameNoExtension}",
        "args": ["--input-file=SLUS_205.91"],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "lldb",
        "preLaunchTask": "C/C++: clang++ compile active file"
    }
    ]
}
